{
  "name": "tam400-vehicle-fuel-efficiency",
  "private": true,
  "scripts": {
    "dev": "concurrently -k -n WEB,API \"npm run dev:web\" \"npm run dev:api\"",
    "dev:web": "npm --prefix apps/web run dev",
    "dev:api": "node scripts/run-api.mjs",
    "build": "npm run build:web && npm run build:api",
    "build:web": "npm --prefix apps/web run build",
    "build:api": "python -m compileall apps/api ml/src",
    "test": "npm run test:web && npm run test:api",
    "test:web": "npm --prefix apps/web run test:run",
    "test:api": "pytest -q",
    "lint": "npm run lint:web && npm run lint:api",
    "lint:web": "npm --prefix apps/web run lint",
    "lint:api": "ruff check . && black --check .",
    "train": "node scripts/run-ml.mjs fuel_efficiency.models.train --config ml/configs/base.yaml",
    "train:lab": "node scripts/run-python-file.mjs notebooks/01_vehicle_fuel_efficiency_lab_style.py",
    "evaluate": "node scripts/run-ml.mjs fuel_efficiency.models.evaluate --config ml/configs/base.yaml",
    "predict:sample": "node scripts/run-ml.mjs fuel_efficiency.models.serialize --sample",
    "docker:up": "docker compose up --build",
    "docker:watch": "docker compose up --watch",
    "ci:check": "npm run lint && npm run test && npm run build"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
